# PSDLimo Booking — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local (.gitignore covers .env*).
# On Vercel, set these under Project → Settings → Environment Variables.

# ── Google Maps ────────────────────────────────────────────────────────────────
# Server-only key. Routes API (computeRouteMatrix). Restrict by API, not referrer.
# MUST NOT be NEXT_PUBLIC_ — it would leak into the browser bundle.
GOOGLE_MAPS_SERVER_KEY=

# Browser key. Places API (New) Autocomplete only. Lock to HTTP referrers:
#   http://localhost:3000/*  and  https://*.vercel.app/*  (add the prod domain later)
NEXT_PUBLIC_MAPS_BROWSER_KEY=

# ── Xendit (TEST MODE) ─────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys → test-mode secret key (starts xnd_development_...)
XENDIT_SECRET_KEY=

# Dashboard → Settings → Callbacks → verification token. Verified as the
# x-callback-token HEADER on every incoming callback.
XENDIT_CALLBACK_TOKEN=

# Invoice currency. CONFIRMED 2026-07-21: this account is PHP-only in test mode
# — USD invoices are NOT available. So:
#   · the UI prices and displays everything in USD (the client's real currency)
#   · lib/payments.ts converts to PHP at the moment of invoice creation only
#   · the USD amount is what gets stored in metadata and written to GHL
# See DEMO_NOTES.md — this is stated to the client, never left to be discovered.
XENDIT_CURRENCY=PHP

# USD→PHP rate used solely to denominate the test invoice. PLACEHOLDER — a fixed
# demo rate, not a live FX feed. Irrelevant at go-live: the production processor
# will be client-owned and charge USD directly.
XENDIT_USD_TO_PHP=58.5

# ── App ────────────────────────────────────────────────────────────────────────
# Public base URL used to build Xendit success/failure redirect URLs.
# Local: http://localhost:3000 — Vercel: https://<project>.vercel.app (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── GoHighLevel (sandbox sub-account) ──────────────────────────────────────────
# Settings → Private Integrations. Scopes: contacts.write, opportunities.write,
# plus read scopes for the ghl:ids script (locations/customFields.readonly,
# opportunities.readonly).
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# Resolved by `npm run ghl:ids` and written into config/ghl-fields.json.
# Kept here too so the webhook can read them without importing the JSON at runtime.
GHL_PIPELINE_ID=
GHL_STAGE_CONFIRMED_ID=

# ── Database (Neon Postgres) ────────────────────────────────────────────────────
# The Neon connection string. Demo runs on Neon's Free tier (throwaway);
# production is a SEPARATE Neon account created under PSD Limo's business email
# (email sign-up, not GitHub-linked) on the Launch plan.
# After setting this: `npm run db:migrate` then `npm run db:seed`.
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Session-signing secret. Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
# Must be >= 32 chars. Rotating it logs everyone out. Set in Vercel too.
AUTH_SECRET=
