{
  "name": "psdlimo-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ghl:ids": "tsx --env-file=.env.local scripts/fetch-ghl-ids.ts",
    "test:pricing": "tsx scripts/test-pricing.ts",
    "test:payments": "tsx --conditions=react-server scripts/test-payments.ts",
    "test:dispatch": "tsx --conditions=react-server --env-file=.env.local scripts/test-dispatch.ts",
    "test": "npm run test:pricing && npm run test:payments",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/db-seed.ts",
    "admin:password": "tsx --conditions=react-server --env-file=.env.local scripts/set-admin-password.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.4",
    "nanoid": "^6.0.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xendit-node": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vercel": "^56.4.1"
  }
}
